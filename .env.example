# API Keys for Code Indexer
# Copy this file to .env and replace with your actual API keys

# Groq API Key for LLM code generation (Llama, Mixtral, etc.)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API Key for LLM code generation (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key for embeddings and optional LLM features
OPENAI_API_KEY=your_openai_api_key_here

# Voyage AI API Key (optional, for code embeddings)
VOYAGE_API_KEY=your_voyage_api_key_here

# Get your API keys from:
# - Groq: https://console.groq.com/
# - Anthropic: https://console.anthropic.com/
# - OpenAI: https://platform.openai.com/api-keys
# - Voyage AI: https://www.voyageai.com/
