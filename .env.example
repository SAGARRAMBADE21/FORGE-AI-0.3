# API Keys for FORGE Code Generation System
# Copy this file to .env and replace with your actual API keys

# =============================================================================
# HUGGING FACE (Default - Qwen/Qwen2.5-Coder-32B-Instruct)
# =============================================================================
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# Alternative: HF_TOKEN=your_huggingface_token_here

# =============================================================================
# OTHER LLM PROVIDERS (Optional)
# =============================================================================

# OpenRouter API Key (for multiple models via one API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key for LLM code generation (Llama, Mixtral, etc.)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API Key for LLM code generation (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key for embeddings and optional LLM features
OPENAI_API_KEY=your_openai_api_key_here

# Voyage AI API Key (optional, for code embeddings)
VOYAGE_API_KEY=your_voyage_api_key_here

# =============================================================================
# GET YOUR API KEYS FROM:
# =============================================================================
# - Hugging Face: https://huggingface.co/settings/tokens
# - OpenRouter: https://openrouter.ai/keys
# - Groq: https://console.groq.com/
# - Anthropic: https://console.anthropic.com/
# - OpenAI: https://platform.openai.com/api-keys
# - Voyage AI: https://www.voyageai.com/
