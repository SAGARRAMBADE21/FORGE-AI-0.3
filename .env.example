# API Keys for FORGE Code Generation System
# Copy this file to .env and replace with your actual API keys

# =============================================================================
# GOOGLE GEMINI (Primary - gemini-2.5-pro)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
# Get your key from: https://aistudio.google.com/apikey

# =============================================================================
# GROQ (LLM code generation - Llama, Mixtral, etc.)
# =============================================================================
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# ANTHROPIC (Claude models)
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# OPENAI (GPT models and embeddings)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# VOYAGE AI (Code embeddings - optional)
# =============================================================================
VOYAGE_API_KEY=your_voyage_api_key_here

# =============================================================================
# OPENROUTER (Multiple models via one API)
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# HUGGING FACE (Model access and tokens)
# =============================================================================
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# =============================================================================
# MONGODB ATLAS (Cloud vector storage)
# =============================================================================
# Get connection string from MongoDB Atlas: Database → Connect → Connect your application
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DATABASE=code_indexer
MONGODB_COLLECTION=code_chunks
MONGODB_INDEX=vector_index

# =============================================================================
# GET YOUR API KEYS FROM:
# =============================================================================
# - Google Gemini: https://aistudio.google.com/apikey
# - Groq: https://console.groq.com/
# - Anthropic: https://console.anthropic.com/
# - OpenAI: https://platform.openai.com/api-keys
# - Voyage AI: https://www.voyageai.com/
# - OpenRouter: https://openrouter.ai/keys
# - Hugging Face: https://huggingface.co/settings/tokens
# - MongoDB Atlas: https://www.mongodb.com/cloud/atlas
